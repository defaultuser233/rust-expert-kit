# 让 git 自动识别文本文件
* text=auto

# Shell 脚本必须 LF
# —— 带 CRLF 的 .sh 在 Linux/macOS 上会报 "bad interpreter: /usr/bin/env bash^M"
*.sh    text eol=lf
*.bash  text eol=lf

# PowerShell 脚本用 CRLF
# —— 注意：.ps1 里的 UTF-8 BOM 是「文件内容」，不受本设置影响，会原样保留
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# 二进制
*.exe   binary
*.png   binary
*.ico   binary
*.gif   binary
